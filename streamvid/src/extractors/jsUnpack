#!/bin/bash

if [ "$#" -ne 1 ]; then
    echo "Uso: $0 <archivo.js>"
    exit 1
fi

input_file="$1"
output="$(mktemp)"

if [ ! -f "$input_file" ]; then
    echo "El archivo '$input_file' no existe."
    exit 1
fi

url="https://onlinetool.app/run/js_unpack"

# POST curl api js_unpack
curl -s --compressed \
  -X POST "$url" \
  -H 'User-Agent: Mozilla/5.0 (X11; Linux x86_64; rv:109.0) Gecko/20100101 Firefox/115.0' \
  -H 'Accept: application/json, text/plain, */*' \
  -H 'Accept-Language: es-MX,es;q=0.8,en-US;q=0.5,en;q=0.3' \
  -H 'Accept-Encoding: gzip, deflate, br' \
  -H 'X-Requested-With: XMLHttpRequest' \
  -H 'Content-Type: multipart/form-data; boundary=---------------------------3958268687257213799508603266' \
  -H 'Origin: https://onlinetool.app' \
  -H 'Sec-GPC: 1' \
  -H 'Connection: keep-alive' \
  -H 'Referer: https://onlinetool.app/ext/js_unpack' \
  -H 'Sec-Fetch-Dest: empty' \
  -H 'Sec-Fetch-Mode: cors' \
  -H 'Sec-Fetch-Site: same-origin' \
  -H 'Pragma: no-cache' \
  -H 'Cache-Control: no-cache' \
  -H 'TE: trailers' \
  --data-binary @- <<EOF > "$output"
-----------------------------3958268687257213799508603266
Content-Disposition: form-data; name="js"

$(cat "$input_file")
-----------------------------3958268687257213799508603266--
EOF

statusCode=$(cat "$output" | jq .status)

if [ "$statusCode" -eq 200 ]; then
	formatted_content=$(cat "$output" | jq -r '.output[]' | sed -e 's/&amp;/&/g' -e 's/&quot;/"/g' -e 's/&#039;/'"'"'/g')
	echo "$formatted_content" | sed 's/&amp;/\&/g'
	rm "$output"
else 
	echo "fail"
	rm "$output"
fi
