#!/bin/bash
# luluvdo Extractor
ucurl () {
local url="$1"
curl -L -s -A "Mozilla/5.0 (X11; Linux x86_64; rv:109.0) Gecko/20100101 Firefox/115.0" "$url"
}

luluvdo() {
local url="$1"
video_link=$(ucurl "$url" | grep -oP '(?<=file:")[^"]*m3u8[^"]*' 2>/dev/null)	
[ -n "$video_link" ] && echo "$video_link"
}

# run test
luluvdo "$1"
