#!/bin/bash
# Mp4upload extractor
url=$1

ucurl () {
  curl -L -s -A "Mozilla/5.0 (X11; Linux x86_64; rv:109.0) Gecko/20100101 Firefox/115.0" \
  -b cookies.txt "$url"
}

mp4upload () {
video_link=$(ucurl "$url" | sed -nE "s@.*src: \"([^\"]*)\".*@\1@p")
[ -n "$video_link" ] && echo "$video_link" 2>/dev/null
}

# run test
mp4upload
