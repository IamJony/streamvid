#!/bin/bash
# streamwish Extractor

jsUnpack=/opt/streamvid/src/extractors/jsUnpack

ucurl () {
  local url="$1"
  curl -L -s -A "Mozilla/5.0 (X11; Linux x86_64; rv:109.0) Gecko/20100101 Firefox/115.0" "$url"
}

streamwish() {
  local url="$1"
  
  # Crear un archivo temporal
  local temp_file=$(mktemp)

  # Descargar el contenido y guardarlo en el archivo temporal
  ucurl "$url" > "$temp_file"

 #cat "$temp_file" > test
  
  # Pasar el archivo temporal a jsUnpack
  video_link=$(bash $jsUnpack "$temp_file" | grep -oP 'file:\s*"\K[^"]+' 2>/dev/null)


  # Limpiar el archivo temporal
  rm -f "$temp_file"

  # Mostrar el enlace del video si se encontró
  [ -n "$video_link" ] && echo "$video_link" | head -n 1
}

# Ejecutar la función con el primer argumento proporcionado
streamwish "$1"

