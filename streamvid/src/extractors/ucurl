#!/bin/bash

# Verifica si se pasa una URL
if [ -z "$1" ]; then
    echo "Usage: $0 <URL> [curl_options...]"
    exit 1
fi

URL="$1"
shift  # Elimina el primer argumento (URL) para procesar los parámetros adicionales

# Configuración del proxy (opcional)
PROXY=""
for arg in "$@"; do
    if [[ "$arg" == -x* ]]; then
        PROXY="${arg#-x }"
        # Elimina el parámetro de proxy de los parámetros de curl
        set -- $(echo "$@" | sed -e 's/-x [^\s]*//')
        break
    fi
done

# Generar un User-Agent aleatorio
USER_AGENTS=(
    "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:115.0) Gecko/20100101 Firefox/115.0"
    "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/115.0.0.0 Safari/537.36"
    "Mozilla/5.0 (Macintosh; Intel Mac OS X 10.15; rv:115.0) Gecko/20100101 Firefox/115.0"
    "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:115.0) Gecko/20100101 Firefox/115.0"
    "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/114.0.0.0 Safari/537.36"
)
USER_AGENT=${USER_AGENTS[$RANDOM % ${#USER_AGENTS[@]}]}

# Generar una Accept-Language aleatoria
ACCEPT_LANGUAGES=(
    "en-US,en;q=0.5"
    "es-ES,es;q=0.9,en;q=0.8"
    "fr-FR,fr;q=0.9,en;q=0.8"
    "de-DE,de;q=0.9,en;q=0.8"
    "it-IT,it;q=0.9,en;q=0.8"
)
ACCEPT_LANGUAGE=${ACCEPT_LANGUAGES[$RANDOM % ${#ACCEPT_LANGUAGES[@]}]}

# Generar un Accept-Encoding aleatorio
ACCEPT_ENCODINGS=(
    "gzip, deflate, br"
    "gzip, deflate"
    "br, gzip"
    "compress, gzip"
)
ACCEPT_ENCODING=${ACCEPT_ENCODINGS[$RANDOM % ${#ACCEPT_ENCODINGS[@]}]}

# Generar un Referer aleatorio
REFERRERS=(
    "https://www.google.com"
    "https://www.wikipedia.org"
    "https://www.jkanime.net"
    "https://www.xnxx.com"
    "https://www.linux.org"
)
REFERER=${REFERRERS[$RANDOM % ${#REFERRERS[@]}]}

# Generar un Accept-Charset aleatorio
ACCEPT_CHARSETS=(
    "utf-8, iso-8859-1;q=0.5"
    "utf-8, iso-8859-1;q=0.7"
    "utf-8"
)
ACCEPT_CHARSET=${ACCEPT_CHARSETS[$RANDOM % ${#ACCEPT_CHARSETS[@]}]}

# Introducir un pequeño retraso para evitar la detección
sleep $((RANDOM % 3 + 1))

# Realiza la solicitud con curl, simulando un navegador web real
curl -L ${PROXY:+-x "$PROXY"} -A "$USER_AGENT" \
     -H "Accept: text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8" \
     -H "Accept-Language: $ACCEPT_LANGUAGE" \
     -H "Accept-Encoding: $ACCEPT_ENCODING" \
     -H "Connection: keep-alive" \
     -H "Upgrade-Insecure-Requests: 1" \
     -H "TE: Trailers" \
     -H "Referer: $REFERER" \
     -H "Accept-Charset: $ACCEPT_CHARSET" \
     -H "DNT: 1" \
     --compressed \
     "$URL" "$@"

